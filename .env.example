# Copie para .env (local) ou cadastre na Vercel: Project > Settings > Environment Variables.
# Nenhum destes valores é segredo (vão para o navegador). NUNCA coloque a service_role key aqui.

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-a-chave-anon-public

# Pix: seu celular com DDD, só números (chave Pix do tipo telefone)
PIX_KEY=48900000000
# Nome do recebedor e cidade no Pix (sem acento, até 25 e 15 caracteres)
PIX_NAME=AMPARA AI
PIX_CITY=CRICIUMA

# WhatsApp da empresa: 55 + DDD + número
WHATSAPP=5548900000000

# Endereço público do site, sem barra no final (usado em canonical e Open Graph)
SITE_URL=https://seu-dominio.com.br

# Opcionais
FEE_RATE=0.15
PAYMENT_LINK=
CONTACT_EMAIL=
